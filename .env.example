# Copy to .env and fill in values. Never commit .env.

# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DATA_DIR=data

# Isolated SQLite file for learner/session/mastery state (not the SQL sandbox).
TUTOR_DB_PATH=data/tutor.sqlite

# Sandbox limits
SQL_TIMEOUT_SECONDS=2
SQL_MAX_ROWS=200
SQL_MAX_QUERY_CHARS=20000

# Hint ladder: reveal the full solution after this many failed submits
# unless the learner asks earlier.
SOLUTION_AFTER_FAILED_ATTEMPTS=5

# LLM tutor (optional). The app runs without these using deterministic feedback.
# Use any OpenAI-compatible Chat Completions API.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
